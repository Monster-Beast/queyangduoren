<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <SteamRoot>$(registry:HKEY_CURRENT_USER\Software\Valve\Steam@SteamPath)</SteamRoot>
    <ONI_GAME_DIR Condition="'$(ONI_GAME_DIR)' == ''">$(SteamRoot)/steamapps/common/OxygenNotIncluded</ONI_GAME_DIR>
    <Managed>$(ONI_GAME_DIR)/OxygenNotIncluded_Data/Managed</Managed>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Peer/**/*.cs"/>
    <ProjectReference Include="../../../src/Game/Game.csproj" Condition="'$(FixturePackageDir)' == ''" />
    <Reference Include="QueyangCoop" HintPath="$(FixturePackageDir)/QueyangCoop.dll" Private="false" Condition="'$(FixturePackageDir)' != ''" />
    <Reference Include="Queyang.Core" HintPath="$(FixturePackageDir)/Queyang.Core.dll" Private="false" Condition="'$(FixturePackageDir)' != ''" />
    <GameAssembly Include="Assembly-CSharp;Assembly-CSharp-firstpass;UnityEngine;UnityEngine.CoreModule;UnityEngine.ScreenCaptureModule;UnityEngine.IMGUIModule;UnityEngine.UIModule;UnityEngine.UI;Unity.TextMeshPro;0Harmony;com.rlabrecque.steamworks.net"/>
    <Reference Include="@(GameAssembly->'$(Managed)/%(Identity).dll')" Private="false"/>
    <Reference Include="$(Managed)/UnityEngine.AnimationModule.dll" Private="false"/>
  </ItemGroup>
</Project>
