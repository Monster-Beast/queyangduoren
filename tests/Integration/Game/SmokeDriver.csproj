<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <SteamRoot>$(registry:HKEY_CURRENT_USER\Software\Valve\Steam@SteamPath)</SteamRoot>
    <ONI_GAME_DIR Condition="'$(ONI_GAME_DIR)' == ''">$(SteamRoot)/steamapps/common/OxygenNotIncluded</ONI_GAME_DIR>
    <Managed>$(ONI_GAME_DIR)/OxygenNotIncluded_Data/Managed</Managed>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Peer/**/*.cs"/>
    <ProjectReference Include="../../../src/Game/Game.csproj" />
    <GameAssembly Include="Assembly-CSharp;Assembly-CSharp-firstpass;UnityEngine;UnityEngine.CoreModule;UnityEngine.UI;0Harmony;com.rlabrecque.steamworks.net"/>
    <Reference Include="@(GameAssembly->'$(Managed)/%(Identity).dll')" Private="false"/>
  </ItemGroup>
</Project>
